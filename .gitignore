# Generated strategy charts. The committed golden copies live in
# packages/ev-engine/test/golden; these are scratch output from `npm run charts`.
charts/
packages/trainer-web/build/

# A working channel between two Claude sessions, not documentation.
handoff/

# The one credential this project holds: Idan's Supabase database connection
# string, pasted once so migrations can be run for him (round 12). It reaches
# that database and nothing else in his account, and it never leaves this file.
.env.local

# Another of Idan's projects writes its notes here. Not this project's work, and
# not something to commit — but the build stamp asks `git status --porcelain`, so
# an untracked folder marks every build dirty (round 22).
Claude outputs/

# Tonight's pre-flop regeneration, in flight (round 28). It is written after
# every class so an hours-long job survives a closed lid, which means it is a
# half-finished file for most of its life — and an untracked file marks every
# build dirty. It is committed only once every EV in it has been checked
# bit-identical against the one that shipped.
packages/ev-engine/assets/uth-preflop-r28.json
