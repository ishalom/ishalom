# Copy to .env and fill in. .env is gitignored — it is the only place secrets live.

# --- the agent --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- RiseUp (money) ---------------------------------------------------------
# input.riseup.co.il/developer/tokens, scope budget:read. Expires after 30 days.
RISEUP_PAT=riseup_pat_...
# RISEUP_API_BASE=https://input.riseup.co.il

# --- Google Calendar (schedule) ---------------------------------------------
# Absolute path to the OAuth client file downloaded from Google Cloud.
GOOGLE_OAUTH_CREDENTIALS=C:\morning-brief\secrets\gcp-oauth.keys.json
# GOOGLE_CALENDAR_MCP_TOKEN_PATH=C:\morning-brief\secrets\calendar-token.json

# --- Roborock (vacuum) ------------------------------------------------------
# Your Roborock app account. Leave blank to hide the robot section entirely.
ROBOROCK_USERNAME=
ROBOROCK_PASSWORD=
# Pick one robot when the account has several (matches on name, case-insensitive).
ROBOROCK_DEVICE_NAME=

# --- local ------------------------------------------------------------------
# Windows: python. macOS/Linux: python3.
PYTHON_BIN=python
# PORT=8080
# HOST=0.0.0.0
