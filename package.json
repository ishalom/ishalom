{
  "name": "morning-brief",
  "version": "0.1.0",
  "private": true,
  "description": "First-gen personal assistant: a Hebrew morning brief rendered on the living-room TV, built on the Claude Agent SDK and MCP servers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "envelopes": "tsx src/cli/envelopes.ts",
    "brief": "tsx src/cli/brief.ts",
    "preview": "tsx src/cli/preview.ts",
    "weekly": "tsx src/cli/weekly.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "clean-now": "tsx src/cli/clean.ts",
    "serve": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "dotenv": "^17.2.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
